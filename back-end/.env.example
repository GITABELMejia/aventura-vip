# ============================================================================
# EJEMPLO DE VARIABLES DE ENTORNO DEL BACKEND
# Copia este archivo como .env y completa los valores (NO subir .env a git)
# ============================================================================

# Puerto donde escucha la API
PORT=3000

# Cadena de conexion a PostgreSQL 15 (contenedor av-test-pg)
# Formato: postgres://USUARIO:CLAVE@HOST:PUERTO/BASE_DE_DATOS
DATABASE_URL=postgres://aventura:aventura123@localhost:5432/aventura_vip

# Clave secreta para firmar los tokens JWT (cambiala en produccion)
JWT_SECRET=cambiar_este_secreto_en_produccion

# Tiempo de vida del token (12 horas)
JWT_EXPIRES_IN=12h

# Origenes permitidos por CORS (separados por coma). Agrega aqui el dominio
# de produccion cuando desplegues (ej: https://tu-sitio.netlify.app)
CORS_ORIGENES=http://localhost:5173,http://localhost:4173

# Rate limit del login: maximo de intentos por IP dentro de la ventana (ms)
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MS=60000
